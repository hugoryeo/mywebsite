{
  "name": "laptop-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop": "electron electron/main.js",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:dist": "node scripts/build-desktop.mjs && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^12.6.0",
    "fast-xml-parser": "^5.11.0",
    "next": "16.3.1",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "electron/main.js",
  "description": "Desktop and web app for tracking laptop inventory, prep status, eBay listings, and AI-assisted pricing",
  "author": "hugoryeo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugoryeo/mywebsite.git"
  }
}
