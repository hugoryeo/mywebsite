// Prisma schema for the Laptop Sales Tracker.
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum BrandOs {
  apple
  windows
}

model Laptop {
  id       String  @id @default(cuid())

  // Short human-facing reference, e.g. "LT-4F2A" — what goes on the sticker
  // and what you search for. Permanent and never reused, unlike the 2-digit
  // codes the old tracker recycled once a laptop sold.
  refCode String @unique

  brandOs  BrandOs

  // Windows-only: which manufacturer (Dell, HP, Lenovo, ...). Apple laptops
  // don't need this since the brand is implied by brandOs.
  brand String?

  // Shared spec fields (both OS branches)
  year         Int?
  processor    String?
  ram          String?
  storage      String?
  modelNumber  String?
  hasCharger   Boolean @default(false)
  notes        String?
  source       String? // where the laptop came from (supplier, trade-in, auction, ...)

  serialNumber String?
  colour       String?
  condition    String? // Excellent | Very Good | Good | Fair | Poor

  // Wattage of the charger being sold with it, when one is included.
  chargerWattage String?

  // Apple-silicon core counts and chassis details, resolved from the model
  // number against the MacBook reference data at entry time. Stored on the
  // record so a generated listing stays stable even if that data is revised.
  cpuCores   Int?
  gpuCores   Int?
  screenSize String?
  macType    String? // "Air" | "Pro"

  // Windows-only
  resolution String?

  // Apple-only
  batteryHealth Int?

  // Shared: cycle count applies to both OS branches
  cycleCount Int?

  // Commercial
  cost  Float? // what we paid for it
  price Float? // current asking / listed price

  // Prep pipeline — must happen in order, but stored as independent flags
  // so any stage can be corrected without cascading.
  statusReset    Boolean @default(false)
  statusCleaned  Boolean @default(false)
  statusPrepared Boolean @default(false)
  statusListed   Boolean @default(false)

  // Sale
  sold      Boolean   @default(false)
  soldPrice Float?
  shipping  Float?
  fees      Float?
  soldAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceEstimates PriceEstimate[]

  @@index([sold])
  @@index([statusPrepared])
}

// A single AI pricing-agent run: it searched the web for eBay sold listings
// matching a laptop's spec and condition, and this is what it found.
model PriceEstimate {
  id       String @id @default(cuid())
  laptopId String
  laptop   Laptop @relation(fields: [laptopId], references: [id], onDelete: Cascade)

  averagePrice Float
  lowPrice     Float?
  highPrice    Float?
  currency     String @default("GBP")
  sampleSize   Int?

  summary String // agent's written explanation of the estimate
  sources String // JSON-encoded array of {title, price, url} it cited

  createdAt DateTime @default(now())

  @@index([laptopId])
}

// Key/value store for API credentials entered via Settings.
// Small local app, single operator — values are stored as plain text.
model Setting {
  key   String @id
  value String
}
